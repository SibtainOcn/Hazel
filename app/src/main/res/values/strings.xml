    <string name="sponsor_title">Support Hazel</string>
    <string name="sponsor_hero_title">Free, and staying that way</string>
    <string name="sponsor_hero_body">Hazel is built in evenings and weekends, and it is given away because a downloader that charges for the download is a worse downloader. Sites change constantly, and keeping up with them is the work.</string>
