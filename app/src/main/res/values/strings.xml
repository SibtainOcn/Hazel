    <string name="sponsor_share_title">Tell someone about it</string>
    <string name="sponsor_share_subtitle">Word of mouth is the whole of this app\'s marketing.</string>
    <string name="sponsor_issues_title">Report what breaks</string>
    <string name="sponsor_issues_subtitle">A site that stopped working is a fix nobody else can write.</string>
    <string name="sponsor_source_title">Read the source</string>
