<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and data-extraction rules for Hazel.

    All user data lives in DataStore preferences (cookies, search history,
    download history, failed-download log, and settings). These files must
    survive an app update, so they are included in both cloud and device-
    to-device transfers.

    The cache directory is excluded: thumbnails and yt-dlp binaries are
    fetched again on first launch and would only slow the restore down.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
